# Vindex public site — Apache settings (one.com runs Apache)

# The pages are PHP now so their text can be edited from the members admin.
DirectoryIndex index.php index.html

Options -Indexes

# Anyone holding an old .html link lands on the right page.
RedirectMatch 301 ^/(index|about|cases|platform|contact)\.html$ /$1.php

# Internal folders: the text library and the build tool are never served.
RedirectMatch 404 ^/(inc|tools)(/.*)?$

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
